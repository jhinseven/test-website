# ===== EDIT THIS: ENVIRONMENT VARIABLES =====
# Copy this file to .env.local and fill in real values.
# Never put secrets in HTML, CSS, or JavaScript files.

# Mailchimp
# NOTE: the signup form does NOT use this file. Its action URL and honeypot
# name are public form values and live in js/content.js under mailingList.
# Only put a Mailchimp API KEY here, and only if a server is added later.
# An API key must never appear in HTML, CSS, or JavaScript.
MAILCHIMP_API_KEY=

# Contact form
# NOTE: the contact form does NOT use this file either. Its endpoint URL is a
# public form-service address and lives in js/content.js under `contact`.
# Only put a private API key here, and only if a server is added later.
CONTACT_FORM_API_KEY=
